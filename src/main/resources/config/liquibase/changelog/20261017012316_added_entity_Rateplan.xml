        <dropDefaultValue tableName="rateplan" columnName="created_date" columnDataType="${datetimeType}"/>
        <dropDefaultValue tableName="rateplan" columnName="modified_date" columnDataType="${datetimeType}"/>
    </changeSet>

    <changeSet id="20261017012316-1-relations" author="jhipster">

