            <column name="rating_group_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="rateplan_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="rateplan_id, rating_group_id" tableName="rel_rateplan__rating_group"/>
    </changeSet>

